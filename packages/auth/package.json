{
  "name": "@nucleus/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./src/index.ts"
    },
    "./middleware": {
      "types": "./dist/src/middleware.d.ts",
      "default": "./src/middleware.ts"
    },
    "./client": {
      "types": "./dist/src/client.d.ts",
      "default": "./src/client.ts"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "default": "./env.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "dev": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check . --write",
    "generate": "dotenv -e ../../.env -- pnpx @better-auth/cli generate --output ../db/src/auth-schema.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/expo": "catalog:",
    "@nucleus/cache": "workspace:*",
    "@nucleus/db": "workspace:*",
    "@nucleus/email": "workspace:*",
    "@t3-oss/env-core": "catalog:",
    "better-auth": "catalog:",
    "better-call": "1.4.0",
    "drizzle-orm": "^0.45.3",
    "next": "catalog:",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nucleus/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "typescript": "7"
  }
}
