{
  "name": "@nucleus/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./root": "./src/root.ts",
    "./trpc": "./src/trpc.ts",
    "./error-keys": "./src/error-keys.ts"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
