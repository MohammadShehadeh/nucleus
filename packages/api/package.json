    "@nucleus/db": "workspace:*",
    "@nucleus/validators": "workspace:*",
    "@trpc/server": "catalog:",
    "drizzle-orm": "^0.45.3",
    "superjson": "2.2.6",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nucleus/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "7"
  }
}
