{
  "name": "@nucleus/ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./styles/*": "./src/styles/*.css",
    "./components/data-table/*": {
      "types": "./dist/src/components/data-table/*.d.ts",
      "default": "./src/components/data-table/*.tsx"
    },
    "./providers/*": {
      "types": "./dist/src/providers/*.d.ts",
      "default": "./src/providers/*.ts"
    },
    "./components/*": {
      "types": "./dist/src/components/*.d.ts",
      "default": "./src/components/*.tsx"
    },
    "./hooks/*": {
      "types": "./dist/src/hooks/*.d.ts",
      "default": "./src/hooks/*.ts"
    },
    "./lib/*": {
      "types": "./dist/src/lib/*.d.ts",
      "default": "./src/lib/*.ts"
    },
    "./types/*": {
      "types": "./dist/src/types/*.d.ts",
      "default": "./src/types/*.ts"
    },
    "./config/*": {
      "types": "./dist/src/config/*.d.ts",
      "default": "./src/config/*.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check . --write",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "ui-add": "pnpm dlx shadcn@latest add && node scripts/fix-imports.js && biome format --write"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@nucleus/validators": "workspace:*",
    "@radix-ui/react-icons": "^1.3.2",
    "@tanstack/react-table": "^9.2.6",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-color": "^3.31.4",
    "@tiptap/extension-highlight": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/extension-text-style": "^3.31.4",
    "@tiptap/extension-underline": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.52.0",
    "nanoid": "^6.0.2",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "radix-ui": "^1.7.0",
    "react-day-picker": "^10.0.2",
    "react-hook-form": "^7.89.0",
    "react-resizable-panels": "^4.14.2",
    "recharts": "3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@nucleus/tailwind-config": "workspace:*",
    "@nucleus/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "react": "catalog:react19",
    "typescript": "7",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:react19",
    "zod": "catalog:"
  }
}
